# ─── Security: block direct access to sensitive files ───────────

# Block dotfiles (.env, .env.backup, .env.example, .gitignore, .gitattributes, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block sensitive root files (Composer, package manifests, build configs, scripts)
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|artisan|README\.md|server\.php|webpack\.mix\.js|vite\.config\.(js|ts)|tsconfig\.json|phpunit\.xml(\.dist)?|tailwind\.config\.(js|ts)|postcss\.config\.(js|ts))$">
    Require all denied
</FilesMatch>

# Disable directory listing
Options -Indexes

# ─── Routing: send everything to public/ ───────────────────────
#
# Hostinger / shared-hosting Apache: document root is public_html/, but
# Laravel's entry point lives at public_html/public/index.php. This
# .htaccess routes incoming requests through public/ without restructuring
# the project layout.
#
# (Local dev with `php artisan serve` ignores .htaccess entirely, so this
# file is only active in production-style Apache environments.)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /public/... used to serve a second copy of every page, and Google indexed
    # both. Send it to the real address (Oct 2026). THE_REQUEST = what the
    # visitor asked for, so the internal rewrite to public/ below can't loop.
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s/public/([^\s?]*) [NC]
    RewriteRule ^ /%1 [R=301,L]

    # --- Security: never serve application source/logs directly (added 2026-08-26) ---
    # Deny app source + logs. BUT allow published front-end assets under
    # public/vendor (Livewire JS, Scribe) served via /vendor/... URLs — blocking
    # those 403s livewire.min.js and breaks every Livewire component (blank tables).
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|node_modules)(/|$) - [F,L]
    RewriteRule ^vendor/(?!livewire/|scribe/) - [F,L]
    RewriteRule ^storage/(logs|framework|app)(/|$) - [F,L]

    # Only public/ holds web files (4 Nov 2026: the project's .git and docs/
    # folders were downloadable through the old "serve any existing file" rule).
    # Dot folders stay closed; .well-known stays open for SSL certificate checks.
    RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
    RewriteCond %{REQUEST_URI} ^/\.well-known/
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else routes through public/index.php
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
